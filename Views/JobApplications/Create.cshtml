@{
    ViewData["Title"] = "Add job application";
}
@model JobApplicationFormViewModel

<div class="form-page">
    <a asp-action="Index" class="back-link">&larr; Board</a>

    <h1 class="page-title mb-4">Add a job application</h1>

    @* Autofill: its own form, outside the job form, so the pasted URL is never posted with the job
       and pressing Enter here autofills instead of saving. Handled by job-autofill.js. *@
    <form id="autofill-form" class="autofill-box mb-4" data-lookup-url="@Url.Action("Lookup")" novalidate>
        <label for="autofill-url" class="form-label fw-semibold mb-1">Autofill from a job posting</label>
        <p class="form-text mt-0 mb-2">Paste the posting's link to fill in the details below. You can review everything before saving.</p>
        <div class="input-group">
            <input id="autofill-url" type="url" class="form-control" placeholder="https://..." autocomplete="off" required />
            <button id="autofill-button" type="submit" class="btn btn-outline-primary">
                <span class="spinner-border spinner-border-sm d-none me-1" aria-hidden="true"></span>
                Autofill
            </button>
        </div>
        <div id="autofill-status" class="form-text mt-2" role="status" aria-live="polite"></div>
    </form>

    <form asp-action="Create" method="post" class="form-panel">
        <partial name="_JobApplicationForm" />
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Add job</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/job-form.js" asp-append-version="true"></script>
    <script src="~/js/job-autofill.js" asp-append-version="true"></script>
}
