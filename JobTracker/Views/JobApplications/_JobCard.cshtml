@model JobCardViewModel
@{
    // Statuses under "Move to", in board order (enum order differs). Archived is under "Actions".
    JobApplicationStatus[] moveStatuses =
    [
        JobApplicationStatus.Saved,
        JobApplicationStatus.Applied,
        JobApplicationStatus.Interviewing,
        JobApplicationStatus.OfferReceived,
    ];
    JobApplicationStatus archived = JobApplicationStatus.Archived;
    bool isArchived = Model.Status == archived;
    // Set by Index.cshtml; defaults to the board's default sort if the partial is used elsewhere.
    JobBoardSort sort = ViewData["BoardSort"] as JobBoardSort? ?? JobBoardSort.Updated;
}

@* The card is a div, not a link, so it can hold the menu button. The title's stretched-link
   covers the whole card, so clicking anywhere else still opens Details. *@
<div class="job-card status-@Model.Status.ToString().ToLowerInvariant()"
     data-id="@Model.ID" data-status="@Model.Status"
     data-applied-at="@Model.AppliedAt?.ToString("yyyy-MM-dd")" data-has-response="@(Model.HasResponse ? "true" : "false")">
    @* data-applied-at / data-has-response feed the summary strip, which job-board.js recomputes after a move. *@
    <div class="d-flex align-items-center gap-2 mb-2">
        <span class="company-monogram">@char.ToUpperInvariant(Model.CompanyName[0])</span>
        <span class="job-card-company text-truncate">@Model.CompanyName</span>

        <div class="dropdown job-card-menu ms-auto">
            @* Fixed positioning lets the menu escape the column's scroll area instead of being clipped by it. *@
            <button type="button" class="job-card-menu-button" data-bs-toggle="dropdown"
                    data-bs-popper-config='{"strategy":"fixed"}'
                    aria-expanded="false" aria-label="Job actions" title="Job actions">&#x22EF;</button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><h6 class="dropdown-header">Move to</h6></li>
                @foreach (JobApplicationStatus status in moveStatuses)
                {
                    bool isCurrent = status == Model.Status;
                    <li>
                        <button type="button" class="dropdown-item @(isCurrent ? "active" : "")"
                                data-status="@status"
                                disabled="@isCurrent" aria-current="@(isCurrent ? "true" : null)">
                            @status.GetDisplayName()
                        </button>
                    </li>
                }

                <li><hr class="dropdown-divider"></li>
                <li><h6 class="dropdown-header">Actions</h6></li>
                <li><a asp-action="Edit" asp-route-id="@Model.ID" class="dropdown-item" draggable="false">Edit…</a></li>
                @* Archive is a status change, so it keeps data-status and is handled like the items above. *@
                <li>
                    <button type="button" class="dropdown-item @(isArchived ? "active" : "")"
                            data-status="@archived"
                            disabled="@isArchived" aria-current="@(isArchived ? "true" : null)">
                        Archive
                    </button>
                </li>
                <li><button type="button" class="dropdown-item text-danger" data-action="delete">Delete…</button></li>
            </ul>
        </div>
    </div>

    <a asp-action="Details" asp-route-id="@Model.ID" class="job-card-title stretched-link" draggable="false">@Model.Title</a>

    @* No status pill: the column (or the Archived section) and the card's colored edge already show it. *@
    @* The age label is always rendered (even empty) so job-board.js can fill it in after a move,
       e.g. a Saved card gets an applied date. The row hides itself when it has nothing to show (site.css). *@
    <div class="job-card-meta d-flex align-items-center gap-2 mt-2">
        @if (!string.IsNullOrWhiteSpace(Model.Location))
        {
            <span class="job-card-location text-truncate">@Model.Location</span>
        }
        <span class="job-card-age ms-auto" title="@JobCardViewModel.AgeTooltip(sort)">@Model.AgeLabel(sort)</span>
    </div>

    @if (Model.NotesPreview is string notes)
    {
        <p class="job-card-notes"><span class="job-card-notes-label">@Html.DisplayNameFor(m => m.NotesPreview):</span> @notes</p>
    }
</div>
