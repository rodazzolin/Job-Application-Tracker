@model JobDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
    string StatusClass(JobApplicationStatus status) => "status-" + status.ToString().ToLowerInvariant();
}

<div class="details-page">
    <a asp-action="Index" class="back-link">&larr; Board</a>

    @* Header: like a large job card. *@
    <header class="details-header @StatusClass(Model.Status)">
        <span class="company-monogram company-monogram-lg">@char.ToUpperInvariant(Model.CompanyName[0])</span>

        <div class="details-heading">
            <div class="details-company">@Model.CompanyName</div>
            <h1 class="page-title mb-2">@Model.Title</h1>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="status-badge">@Model.Status.GetDisplayName()</span>
                <span class="small text-body-secondary" title="Since @DateDisplay.Full(Model.StatusSince)">@Model.StatusDuration</span>
            </div>
        </div>

        <div class="details-actions">
            @if (Model.PostingHost is not null)
            {
                <a href="@Model.PostingURL" target="_blank" rel="noopener" class="btn btn-outline-secondary posting-button"
                   title="@Model.PostingURL">
                    <span>Open posting &#x2197;</span>
                    <span class="posting-host">@Model.PostingHost</span>
                </a>
            }
            <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-primary">Edit</a>
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary details-menu-button" data-bs-toggle="dropdown"
                        aria-expanded="false" aria-label="More actions" title="More actions">&#x22EF;</button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#delete-modal">Delete…</button>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    @* Facts: the job's stored details and dates. Relative text, exact date on hover. *@
    <section class="fact-grid" aria-label="Job details">
        <div class="fact">
            <div class="fact-label">@Html.DisplayNameFor(m => m.Location)</div>
            <div class="fact-value @(Model.Location is null ? "is-empty" : "")">@(Model.Location ?? "—")</div>
        </div>
        <div class="fact">
            <div class="fact-label">@Html.DisplayNameFor(m => m.PostedAt)</div>
            @if (Model.PostedAt is DateOnly posted)
            {
                <div class="fact-value" title="@DateDisplay.Full(posted)">@DateDisplay.Ago(posted)</div>
            }
            else
            {
                <div class="fact-value is-empty">—</div>
            }
        </div>
        <div class="fact">
            <div class="fact-label">@Html.DisplayNameFor(m => m.AppliedAt)</div>
            @if (Model.AppliedAt is DateOnly applied)
            {
                <div class="fact-value" title="@DateDisplay.Full(applied)">@DateDisplay.Ago(applied)</div>
            }
            else
            {
                <div class="fact-value is-empty">Not yet</div>
            }
        </div>
        <div class="fact">
            <div class="fact-label">@Html.DisplayNameFor(m => m.CreatedAt)</div>
            <div class="fact-value" title="@DateDisplay.Full(Model.CreatedAt)">@DateDisplay.Ago(Model.CreatedAt)</div>
        </div>
        <div class="fact">
            <div class="fact-label">@Html.DisplayNameFor(m => m.UpdatedAt)</div>
            <div class="fact-value" title="@DateDisplay.Full(Model.UpdatedAt)">@DateDisplay.Ago(Model.UpdatedAt)</div>
        </div>
    </section>

    <section class="mb-4" aria-labelledby="notes-title">
        <div class="d-flex align-items-baseline justify-content-between gap-2 mb-3">
            <h2 id="notes-title" class="section-title mb-0">Notes</h2>
            @* Jumps to the notes box on the Edit page (its textarea has id="Notes"). *@
            <a asp-action="Edit" asp-route-id="@Model.ID" asp-fragment="Notes" class="small">
                @(Model.Notes is null ? "Add notes" : "Edit notes")
            </a>
        </div>
        @if (Model.Notes is not null)
        {
            @* Razor HTML-encodes the text; CSS keeps the user's line breaks. *@
            <div class="notes-body">@Model.Notes</div>
        }
        else
        {
            <p class="notes-empty">No notes yet.</p>
        }
    </section>

    @* History, newest first. The last entry is always the job being added. *@
    <section>
        <h2 class="section-title mb-3">History</h2>
        <ol class="timeline">
            @foreach (JobTimelineEntry entry in Model.Timeline)
            {
                <li class="timeline-entry @StatusClass(entry.Status)">
                    <div class="timeline-text">
                        @if (entry.FromStatus is JobApplicationStatus from)
                        {
                            <span class="text-body-secondary">@from.GetDisplayName()</span>
                            <span class="text-body-secondary" aria-label="to">&rarr;</span>
                            <span class="status-badge">@entry.Status.GetDisplayName()</span>
                        }
                        else
                        {
                            <span>Added as</span>
                            <span class="status-badge">@entry.Status.GetDisplayName()</span>
                        }
                    </div>
                    <time class="timeline-time" datetime="@entry.Time.ToString("o")" title="@DateDisplay.Full(entry.Time)">@DateDisplay.Ago(entry.Time)</time>
                </li>
            }
        </ol>
    </section>
</div>

@* Delete confirmation dialog, opened from the ⋯ menu. *@
<div class="modal fade" id="delete-modal" tabindex="-1" aria-labelledby="delete-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="delete-modal-title">Delete job</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Delete <strong>@Model.Title at @Model.CompanyName</strong>? This also removes its status history and can't be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-action="Delete" asp-route-id="@Model.ID">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
