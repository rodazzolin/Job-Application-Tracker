@model JobBoardViewModel
@{
    ViewData["Title"] = "Application Tracker";
    JobApplicationStatus archived = JobApplicationStatus.Archived;
}

@* Token the board script sends with each status update (anti-forgery). *@
@Html.AntiForgeryToken()

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
    <h1 class="page-title mb-0">Application Tracker</h1>
    <div class="d-flex align-items-center gap-2">
        @* GET form: changing the range reloads the board with ?range=... (auto-submitted by job-board.js). *@
        <form id="range-form" method="get" asp-action="Index">
            <select name="range" class="form-select" aria-label="@Html.DisplayNameFor(m => m.Range)">
                @foreach (JobBoardRange range in Enum.GetValues<JobBoardRange>())
                {
                    <option value="@range" selected="@(range == Model.Range)">@range.GetDisplayName()</option>
                }
            </select>
            <noscript><button type="submit" class="btn btn-outline-secondary">Apply</button></noscript>
        </form>
        <a asp-action="Create" class="btn btn-primary text-nowrap">+ Add job</a>
    </div>
</div>

<div id="job-board" class="job-board" data-update-url="@Url.Action("UpdateStatus")">
    @foreach (JobBoardColumn column in Model.Columns)
    {
        <section class="board-column status-@column.Status.ToString().ToLowerInvariant()">
            <header class="board-column-header">
                <h2 class="board-column-title">@column.Title</h2>
                <span class="board-column-count">@column.Jobs.Count</span>
            </header>

            <div class="board-list" data-status="@column.Status" data-status-label="@column.Status.GetDisplayName()">
                @foreach (JobCardViewModel jobApp in column.Jobs)
                {
                    <partial name="_JobCard" model="jobApp" />
                }
                <p class="board-column-empty @(column.Jobs.Count > 0 ? "d-none" : "")">No jobs here yet.</p>
            </div>
        </section>
    }
</div>

<section id="archived-section" class="@(Model.Archived.Count == 0 ? "d-none" : "")">
    <h2 class="section-title mt-5 mb-3">Archived</h2>
    <div id="archived-list" class="job-grid">
        @foreach (JobCardViewModel jobApp in Model.Archived)
        {
            <partial name="_JobCard" model="jobApp" />
        }
    </div>
</section>

@* Drop target for archiving a job. Shown only while a card is being dragged. *@
<div id="drop-zones" class="drop-zones" aria-hidden="true">
    <div class="drop-zone status-@archived.ToString().ToLowerInvariant()"
         data-status="@archived" data-status-label="@archived.GetDisplayName()">
        <span class="drop-zone-label">Archive</span>
    </div>
</div>

@* Error toast for failed updates. *@
<div class="toast-container position-fixed top-0 end-0 p-3">
    <div id="board-toast" class="toast text-bg-danger border-0" role="alert" aria-live="assertive">
        <div class="d-flex">
            <div class="toast-body">Couldn't update the job's status. Please try again.</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/sortablejs/Sortable.min.js"></script>
    <script src="~/js/job-board.js" asp-append-version="true"></script>
}
