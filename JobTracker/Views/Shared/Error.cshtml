@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="error-page text-center mx-auto">
    <p class="error-code">@Model.StatusCode</p>
    <h1 class="page-title">@Model.Title</h1>
    <p class="text-body-secondary mb-4">@Model.Message</p>

    <div class="d-flex justify-content-center gap-2">
        <a asp-controller="JobApplications" asp-action="Index" class="btn btn-primary">Back to your board</a>
        <button type="button" class="btn btn-outline-secondary" onclick="history.back()">Go back</button>
    </div>

    @if (Model.ShowRequestId)
    {
        @* Matches the request in the server logs, if you need to look into what happened. *@
        <p class="small text-body-tertiary mt-5 mb-0">Request ID: <code>@Model.RequestId</code></p>
    }
</div>
