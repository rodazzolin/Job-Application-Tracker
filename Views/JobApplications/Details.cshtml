@model JobApplication
@{
    ViewData["Title"] = Model.Title;
}

<h1>@Model.Title</h1>
<h4 class="text-muted">@Model.Company.Name</h4>

<dl class="row mt-4">
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Location</dt>
    <dd class="col-sm-9">@(Model.Location ?? "—")</dd>

    <dt class="col-sm-3">Posting</dt>
    <dd class="col-sm-9">
        @if (Model.PostingURL is not null)
        {
            <a href="@Model.PostingURL" target="_blank" rel="noopener">View posting</a>
        }
        else
        {
            <text>—</text>
        }
    </dd>

    @* Applied, Posted, Created, Updated: same pattern *@
</dl>

<h3 class="mt-4">History</h3>
<ul class="list-group">
    @foreach (var change in Model.StatusChanges)
    {
        <li class="list-group-item">
            @change.Time.ToLocalTime().ToString("MMM d, yyyy h:mm tt"):
            @change.OldStatus → @change.NewStatus
        </li>
    }
</ul>

<a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-outline-primary mt-3">Edit</a>
<a asp-action="Index" class="btn btn-secondary mt-3">Back</a>